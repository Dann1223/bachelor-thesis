--- !u!114 &996316263
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 996316261}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cfa945379c72b5a46919feb4d915daf3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Manager_Int: 0
  MyEnglish: "White tea is the most natural and simplest tea among the six major
    categories, a lightly fermented tea (fermentation level 5%-10%). Its core process
    is withering + drying, without fixation or rolling, maximizing the retention
    of natural substances in tea leaves. Characteristics: Dry leaves covered with
    white hairs, silver-white and gray-green in color, light apricot-yellow or pale
    yellow-green clear liquor, fresh, sweet and mellow taste with pekoe and honey
    notes, soft flavor without bitterness, and the older the better. Famous Varieties:
    Baihao Yinzhen (Silver Needle), Baimudan (White Peony), Gongmei, Shoumei, etc.
    Process: Picking \u2192 Withering (natural or heated) \u2192 Drying, processed
    only by natural sun-drying or low-temperature baking."
  MyChinese: "\u767D\u8336\u662F\u516D\u5927\u8336\u7C7B\u4E2D\u5DE5\u827A\u6700\u81EA\u7136\u3001\u6700\u7B80\u5355\u7684\u8336\u7C7B\uFF0C\u5C5E\u4E8E\u5FAE\u53D1\u9175\u8336\uFF08\u53D1\u9175\u5EA6
    5%-10%\uFF09\uFF0C\u6838\u5FC3\u5DE5\u827A\u662F\u840E\u51CB + \u5E72\u71E5\uFF0C\u4E0D\u6740\u9752\u3001\u4E0D\u63C9\u637B\uFF0C\u6700\u5927\u7A0B\u5EA6\u4FDD\u7559\u8336\u53F6\u7684\u5929\u7136\u7269\u8D28\u3002
    \u7279\u70B9\uFF1A\u5E72\u8336\u6EE1\u62AB\u767D\u6BEB\u3001\u8272\u6CFD\u94F6\u767D\u7070\u7EFF\uFF0C\u8336\u6C64\u6D45\u674F\u9EC4\u6216\u6DE1\u9EC4\u7EFF\uFF0C\u6E05\u6F88\u660E\u4EAE\uFF0C\u6ECB\u5473\u9C9C\u723D\u6E05\u751C\u3001\u6BEB\u9999\u871C\u97F5\uFF0C\u53E3\u611F\u67D4\u548C\uFF0C\u65E0\u82E6\u6DA9\u611F\uFF0C\u8D8A\u9648\u8D8A\u9999\u3002
    \u4EE3\u8868\u54C1\u7C7B\uFF1A\u767D\u6BEB\u94F6\u9488\u3001\u767D\u7261\u4E39\u3001\u8D21\u7709\u3001\u5BFF\u7709\u7B49\u3002
    \u5DE5\u827A\uFF1A\u9C9C\u53F6\u91C7\u6458\u2192\u840E\u51CB\uFF08\u81EA\u7136\u840E\u51CB\u6216\u52A0\u6E29\u840E\u51CB\uFF09\u2192\u5E72\u71E5\uFF0C\u4EC5\u901A\u8FC7\u81EA\u7136\u667E\u6652\u6216\u4F4E\u6E29\u70D8\u5E72\u5B8C\u6210\u52A0\u5DE5\u3002"
