--- !u!114 &425217917
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 425217915}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cfa945379c72b5a46919feb4d915daf3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Manager_Int: 0
  MyEnglish: "Black tea is a fully fermented tea (fermentation level 80%-90%), the
    most consumed tea in the world. Its core process is fermentation (complete enzymatic
    oxidation of tea polyphenols). Characteristics: Dark and oily dry leaves, bright
    deep red liquor, red and uniform infused leaves, rich sweet aroma (honey, floral,
    fruity, pine smoke, etc.), mellow and sweet taste, mild flavor, suitable for
    drinking with milk or sugar. Famous Varieties: Keemun Black Tea, Lapsang Souchong,
    Jin Jun Mei, Dianhong, Yinghong No.9, etc. Process: Picking \u2192 Withering
    \u2192 Rolling \u2192 Fermentation (core process) \u2192 Drying. Fermentation
    produces theaflavins and thearubigins, forming the characteristic of \"red soup
    and red leaves\"."
  MyChinese: "\u7EA2\u8336\u5C5E\u4E8E\u5168\u53D1\u9175\u8336\uFF08\u53D1\u9175\u5EA6
    80%-90%\uFF09\uFF0C\u662F\u5168\u7403\u6D88\u8D39\u91CF\u6700\u9AD8\u7684\u8336\u7C7B\uFF0C\u6838\u5FC3\u5DE5\u827A\u662F\u53D1\u9175\uFF08\u8336\u591A\u915A\u5B8C\u5168\u9176\u4FC3\u6C27\u5316\uFF09\u3002
    \u7279\u70B9\uFF1A\u5E72\u8336\u8272\u6CFD\u4E4C\u6DA6\uFF0C\u8336\u6C64\u7EA2\u6D53\u660E\u4EAE\uFF0C\u53F6\u5E95\u7EA2\u5300\uFF0C\u9999\u6C14\u751C\u9999\u6D53\u90C1\uFF08\u871C\u9999\u3001\u82B1\u679C\u9999\u3001\u677E\u70DF\u9999\u7B49\uFF09\uFF0C\u6ECB\u5473\u9187\u539A\u751C\u6DA6\uFF0C\u53E3\u611F\u6E29\u548C\uFF0C\u9002\u5408\u52A0\u5976\u3001\u52A0\u7CD6\u996E\u7528\u3002
    \u4EE3\u8868\u54C1\u7C7B\uFF1A\u7941\u95E8\u7EA2\u8336\u3001\u6B63\u5C71\u5C0F\u79CD\u3001\u91D1\u9A8F\u7709\u3001\u6EC7\u7EA2\u3001\u82F1\u7EA2\u4E5D\u53F7\u7B49\u3002
    \u5DE5\u827A\uFF1A\u9C9C\u53F6\u91C7\u6458\u2192\u840E\u51CB\u2192\u63C9\u637B\u2192\u53D1\u9175\uFF08\u6838\u5FC3\u5DE5\u827A\uFF09\u2192\u5E72\u71E5\uFF0C\u53D1\u9175\u4F7F\u8336\u53F6\u4EA7\u751F\u8336\u9EC4\u7D20\u3001\u8336\u7EA2\u7D20\uFF0C\u5F62\u6210
    \u201C\u7EA2\u6C64\u7EA2\u53F6\u201D \u7684\u7279\u5F81\u3002"
--- !u!114 &425217918
