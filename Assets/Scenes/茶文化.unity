  m_text: "\u9EC4\u8336\u662F\u4E2D\u56FD\u7279\u6709\u7684\u8336\u7C7B\uFF0C\u6838\u5FC3\u5DE5\u827A\u662F\u95F7\u9EC4\uFF08\u5728\u6740\u9752\u540E\u5BF9\u8336\u53F6\u8FDB\u884C\u6E7F\u70ED\u95F7\u5806\uFF0C\u4FC3\u4F7F\u8336\u591A\u915A\u53D1\u751F\u975E\u9176\u4FC3\u6C27\u5316\uFF09\uFF0C\u5C5E\u4E8E\u5FAE\u53D1\u9175\u8336\uFF08\u53D1\u9175\u5EA6
    10%-20%\uFF09\u3002\n\u7279\u70B9\uFF1A\u5E72\u8336\u5448\u9EC4\u5AE9\u8272\u6CFD\uFF0C\u8336\u6C64\u674F\u9EC4\u660E\u4EAE\uFF0C\u53F6\u5E95\u5AE9\u9EC4\u5300\u6574\uFF0C\u53E3\u611F\u9C9C\u9187\u7518\u723D\uFF0C\u517C\u5177\u7EFF\u8336\u7684\u9C9C\u723D\u4E0E\u7EA2\u8336\u7684\u751C\u9187\uFF0C\u65E0\u82E6\u6DA9\u611F\u3002\n\u4EE3\u8868\u54C1\u7C7B\uFF1A\u541B\u5C71\u94F6\u9488\u3001\u8499\u9876\u9EC4\u82BD\u3001\u970D\u5C71\u9EC4\u82BD\u3001\u6CA9\u5C71\u6BDB\u5C16\u7B49\u3002\n\u5DE5\u827A\uFF1A\u9C9C\u53F6\u91C7\u6458\u2192\u6740\u9752\u2192\u63C9\u637B\u2192\u95F7\u9EC4\u2192\u5E72\u71E5\uFF0C\u95F7\u9EC4\u662F\u5F62\u6210\u9EC4\u8336
    \u201C\u9EC4\u6C64\u9EC4\u53F6\u201D \u7684\u5173\u952E\u3002"
